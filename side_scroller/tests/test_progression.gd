extends RefCounted
const H=preload("res://tests/helpers.gd")
func run(t):
    var s = load("res://systems/character_state.gd").new()
    t.check(s.level == 1, "new character begins at level one")
    if s.level != 1: return
    t.check(s.attributes == {"STR": 4, "DEX": 4, "INT": 4, "LUK": 4}, "four starting attributes")
    s.add_xp(-9)
    t.check(s.xp == 0, "negative XP ignored")
    s.add_xp(s.xp_required(1) + s.xp_required(2))
    t.check(s.level == 3 and s.ap == 10, "multi-level XP grants each AP reward once")
    t.check(s.sp["0"]==2,"novices earn one novice skill point per level")
    t.check(s.rank_up("three_snails") and s.skill_ranks.three_snails==1,"novice skill learns with a novice point")
    t.check(not s.allocate_attributes({"STR": 11}) and s.ap == 10, "overspent allocation rejected")
    t.check(s.allocate_attributes({"STR": 5}) and s.ap == 5 and s.attributes.STR == 9, "valid allocation applied")
    t.check(not s.allocate_attributes({"STR": -1}), "negative allocation rejected")
    t.check(not s.advance_job("warrior"), "first job locked before ten")
    H.reach(s,10)
    t.check(s.sp["0"]<=9,"novice points stop at nine")
    t.check(s.advance_job("warrior") and s.sp["1"] == 1, "first advancement grants tier SP")
    t.check(not s.advance_job("warrior") and s.sp["1"] == 1, "duplicate advancement rejected")
    t.check(not s.can_use("power_strike") and s.rank_up("power_strike") and s.can_use("power_strike"), "first-job skills must be learned with a skill point")
    t.check(not s.rank_up("rage"), "second-job skills are locked")
    s.add_xp(s.xp_required(10))
    t.check(s.sp["1"] == 3, "post-job level grants three tier points")
    H.reach(s,30)
    t.check(s.next_jobs()==["fighter","page","spearman"],"warriors choose between three second-job paths")
    t.check(not s.advance_job("assassin") and not s.advance_job("crusader"),"other classes' jobs and skipped tiers are rejected")
    t.check(s.advance_job("spearman") and s.sp["2"] == 1, "second advancement grants one second-tier point")
    t.check(s.next_jobs()==["dragon_knight"],"a chosen path continues to its own third job")
    t.check(not s.rank_up("rage") and not s.rank_up("charge_blow"),"skills from other paths cannot be learned")
    t.check(s.rank_up("hyper_body"), "path skill learns with second-tier point")
    t.check(not s.rank_up("iron_will"), "empty point pool rejects spending")
    t.check(not s.advance_job("dragon_knight"), "third job waits for level 70")
    var expected = 120 + 16 * 29 + 2 * 5
    t.check(s.derived_stats().max_hp == expected, "HP uses the warrior growth formula")
    var old_hp = s.hp
    t.check(s.allocate_attributes({"INT": 2}), "INT allocates")
    t.check(s.hp == old_hp, "allocation does not secretly heal current HP")
    var mage=H.make("magician")
    H.reach(mage,8)
    t.check(mage.advance_job("magician") and mage.job_name()=="Initiate","mages take their first job at level 8")
    t.check(mage.basic_skill()=="basic" and mage.weapon_type()=="staff","mages start with a staff")
    var archer=H.make("bowman")
    t.check(archer.basic_skill()=="arrow","archers shoot arrows from level one")
    var top=H.make("thief",["thief","bandit","chief_bandit","shadower"],120)
    t.check(top.job_name()=="Duskreaper" and top.tier()==4,"fourth job reachable at level 120")
    var points=top.ap
    top.add_xp(99999999)
    t.check(top.level==200 and top.xp==0,"level cap is 200")
    var copy=load("res://systems/character_state.gd").new()
    t.check(copy.load_record(top.to_record()),"level-200 fourth-job character survives save validation")
